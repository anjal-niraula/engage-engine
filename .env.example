ENGAGE_PRIMARY.ENV="local"

ENGAGE_SERVER.PORT="8080"
ENGAGE_SERVER.READ_TIMEOUT="30"
ENGAGE_SERVER.WRITE_TIMEOUT="30"
ENGAGE_SERVER.IDLE_TIMEOUT="60"
ENGAGE_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"
ENGAGE_SERVER.JWT_SECRET="engage-engine-dev-secret-key-32bytes!"

ENGAGE_DATABASE.HOST="localhost"
ENGAGE_DATABASE.PORT="5432"
ENGAGE_DATABASE.USER="postgres"
ENGAGE_DATABASE.PASSWORD="postgres"
ENGAGE_DATABASE.NAME="engage_engine"
ENGAGE_DATABASE.SSL_MODE="disable"
ENGAGE_DATABASE.MAX_OPEN_CONNS="25"
ENGAGE_DATABASE.MAX_IDLE_CONNS="25"
ENGAGE_DATABASE.CONN_MAX_LIFETIME="300"
ENGAGE_DATABASE.CONN_MAX_IDLE_TIME="300"

ENGAGE_REDIS.ADDRESS="localhost:6379"

# Kafka Event Streaming
ENGAGE_KAFKA.BROKERS="localhost:9092"
ENGAGE_KAFKA.GROUP_ID="engage-engine"
ENGAGE_KAFKA.TOPIC="engage.events"

# Docker Compose Environment Variables
ENGAGE_DATABASE_USER="postgres"
ENGAGE_DATABASE_PASSWORD="postgres"
ENGAGE_DATABASE_NAME="engage_engine"
ENGAGE_DATABASE_PORT="5432"
ENGAGE_REDIS_PORT="6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================
ENGAGE_OBSERVABILITY.SERVICE_NAME="engage-engine"
ENGAGE_OBSERVABILITY.ENVIRONMENT="local"

# Logging Settings
ENGAGE_OBSERVABILITY.LOGGING.LEVEL="debug"
ENGAGE_OBSERVABILITY.LOGGING.FORMAT="console"
ENGAGE_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# New Relic APM (Optional)
ENGAGE_OBSERVABILITY.NEW_RELIC.LICENSE_KEY=""
ENGAGE_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="false"
ENGAGE_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="false"
ENGAGE_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# Health Check Settings
ENGAGE_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
ENGAGE_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
ENGAGE_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
ENGAGE_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"
